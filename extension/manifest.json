{
  "manifest_version": 3,
  "name": "GlassWeb Recorder",
  "version": "0.4.0",
  "description": "Save a private, redacted browser recording for GlassWeb before-and-after checks.",
  "permissions": ["activeTab", "downloads", "scripting", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "GlassWeb Recorder",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
